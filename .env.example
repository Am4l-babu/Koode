# ─── Database ──────────────────────────────────────────────
DATABASE_URL="postgresql://donation:donation@localhost:5432/donation_dev?schema=public"

# ─── Secrets (generate with: openssl rand -base64 32) ──────
# 32-byte key (base64) used for AES-256-GCM encryption of PII at rest.
DATA_ENCRYPTION_KEY=""
# Secret for HMAC (session token hashing, donor aliases, signed document URLs).
APP_SECRET=""

# ─── App ───────────────────────────────────────────────────
APP_URL="http://localhost:3000"
# Set to "true" behind HTTPS so cookies are marked Secure (default: true in production).
COOKIE_SECURE=""

# ─── Development seed admin (never used in production) ─────
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# ─── Bot protection (optional) — Cloudflare Turnstile ──────
TURNSTILE_SECRET_KEY=""
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""

# ─── Notifications (optional) ──────────────────────────────
# email: "console" (dev) | "resend"
EMAIL_DRIVER="console"
RESEND_API_KEY=""
EMAIL_FROM="Sahaya Bridge <no-reply@example.org>"
# sms / whatsapp: "console" (dev) | "disabled"
SMS_DRIVER="console"
WHATSAPP_DRIVER="disabled"

# ─── Private document storage ──────────────────────────────
# "local" stores files under STORAGE_DIR (outside /public). S3/R2 adapter: "s3".
STORAGE_DRIVER="local"
STORAGE_DIR="./storage/private"
